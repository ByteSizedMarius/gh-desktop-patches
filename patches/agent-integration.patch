new file mode 100644
index 0000000..71cb7a0
--- /dev/null
+++ b/app/src/lib/agents/index.ts
@@ -0,0 +1,136 @@
+import { ChildProcess, spawn, execFile } from 'child_process'
+import { promisify } from 'util'
+import {
+  ICustomIntegration,
+  parseCustomIntegrationArguments,
+  expandTargetPathArgument,
+  spawnCustomIntegration,
+} from '../custom-integration'
+
+const execFileAsync = promisify(execFile)
+
+export enum Agent {
+  ClaudeCode = 'Claude Code',
+  Codex = 'Codex',
+}
+
+const agentExecutables: Record<Agent, string> = {
+  [Agent.ClaudeCode]: 'claude',
+  [Agent.Codex]: 'codex',
+}
+
+export interface IFoundAgent {
+  readonly agent: Agent
+  readonly path: string
+}
+
+let agentCache: ReadonlyArray<IFoundAgent> | null = null
+
+async function findExecutable(name: string): Promise<string | null> {
+  try {
+    if (__WIN32__) {
+      const { stdout } = await execFileAsync('where.exe', [name])
+      const firstLine = stdout.trim().split(/\r?\n/)[0]
+      return firstLine || null
+    } else {
+      const { stdout } = await execFileAsync('which', [name])
+      return stdout.trim() || null
+    }
+  } catch {
+    return null
+  }
+}
+
+export async function getAvailableAgents(): Promise<
+  ReadonlyArray<IFoundAgent>
+> {
+  if (agentCache !== null) {
+    return agentCache
+  }
+
+  const found: IFoundAgent[] = []
+
+  for (const [agent, executable] of Object.entries(agentExecutables)) {
+    const path = await findExecutable(executable)
+    if (path) {
+      found.push({ agent: agent as Agent, path })
+    }
+  }
+
+  agentCache = found
+  return found
+}
+
+export async function findAgentOrDefault(
+  name: string | null
+): Promise<IFoundAgent | null> {
+  const agents = await getAvailableAgents()
+  if (agents.length === 0) {
+    return null
+  }
+
+  if (name) {
+    const match = agents.find(a => a.agent === name)
+    if (match) {
+      return match
+    }
+  }
+
+  return agents[0]
+}
+
+/**
+ * Launch a built-in agent in a new terminal window at the given repo path.
+ * Uses the same shell-spawn approach as the shell integration.
+ */
+export function launchAgent(
+  agent: IFoundAgent,
+  repoPath: string
+): ChildProcess {
+  const executable = agentExecutables[agent.agent]
+
+  if (__WIN32__) {
+    return spawn('START', [`"${agent.agent}"`, 'cmd', '/c', executable], {
+      shell: true,
+      cwd: repoPath,
+    })
+  } else if (__DARWIN__) {
+    // Open a Terminal.app running the agent
+    const script = `cd "${repoPath}" && ${executable}`
+    return spawn('osascript', [
+      '-e',
+      `tell application "Terminal" to do script "${script}"`,
+    ])
+  } else {
+    // Linux: try common terminal emulators
+    return spawn('x-terminal-emulator', ['-e', executable], {
+      cwd: repoPath,
+    })
+  }
+}
+
+/**
+ * Launch a custom agent in a new terminal window at the given repo path.
+ */
+export function launchCustomAgent(
+  customAgent: ICustomIntegration,
+  repoPath: string
+): ChildProcess {
+  const argv = parseCustomIntegrationArguments(customAgent.arguments)
+  const args = expandTargetPathArgument(argv, repoPath)
+  const cmd = customAgent.path
+
+  if (__WIN32__) {
+    // Launch in a new terminal: START "title" cmd /c "<path> <args>"
+    const fullCmd = [cmd, ...args].join(' ')
+    return spawn('START', ['"Agent"', 'cmd', '/c', fullCmd], {
+      shell: true,
+      cwd: repoPath,
+    })
+  } else {
+    return spawnCustomIntegration(`"${cmd}"`, args, {
+      shell: true,
+      cwd: repoPath,
+    })
+  }
+}
