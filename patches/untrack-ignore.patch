diff --git a/app/src/lib/git/rm.ts b/app/src/lib/git/rm.ts
index 0fb5821..8627575 100644
--- a/app/src/lib/git/rm.ts
+++ b/app/src/lib/git/rm.ts
@@ -29,3 +29,15 @@ export async function removeConflictedFile(
 ) {
   await git(['rm', '--', file.path], repository.path, 'removeConflictedFile')
 }
+
+/** Remove files from the index but keep them on disk */
+export async function untrackFiles(
+  repository: Repository,
+  paths: ReadonlyArray<string>
+): Promise<void> {
+  await git(
+    ['rm', '--cached', '--', ...paths],
+    repository.path,
+    'untrackFiles'
+  )
+}
